{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PULSE",
  "version": "0.1.0-dev",
  "identifier": "dev.pulse.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PULSE",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0d1013"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "linux": {
      "rpm": {
        "depends": ["webkit2gtk4.1", "libappindicator-gtk3"]
      },
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libayatana-appindicator3-1"]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "wix": {
        "version": "0.1.0",
        "upgradeCode": "da6d24c5-619e-50aa-849a-3db0ed9470df"
      }
    },
    "publisher": "PULSE contributors",
    "category": "Utility",
    "shortDescription": "A modular, cross-platform system monitor with desktop overlays.",
    "longDescription": "PULSE is a modular, cross-platform system monitoring dashboard for Windows and Fedora Linux, with live metrics, history, dashboards and desktop overlays."
  }
}
